# .env.example
# 이 프로젝트에서 사용하는 환경 변수 목록입니다.
# 실제 값은 .env 파일에 작성해주세요.

# Groq
GROQ_API_KEY=
# Groq 모델명 (선택). 비워두면 코드 default(llama-3.3-70b-versatile) 사용.
# 후보: llama-3.3-70b-versatile (권장, 12K TPM), llama-3.1-8b-instant (6K TPM)
GROQ_MODEL=

# Redis
REDIS_URL=

# 예시:
# SOME_API_KEY="your_api_key_here"
